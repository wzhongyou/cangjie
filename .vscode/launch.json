{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Cangjie Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/plugin", "${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/plugin/dist/**/*.js"],
      "preLaunchTask": "build-cangjie",
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
      }
    }
  ]
}
