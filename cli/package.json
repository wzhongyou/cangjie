{
  "name": "@cangjie/cli",
  "version": "0.2.0",
  "description": "Cangjie CLI — 命令行代码智能体",
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    ".": "./dist/main.js"
  },
  "bin": {
    "cangjie": "./dist/main.js",
    "cj": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "build:binary": "bun build ./dist/main.js --compile --outfile ../cj",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cangjie/core": "workspace:*",
    "@cangjie/shared": "workspace:*",
    "@types/react": "^19.2.17",
    "ink": "^7.1.0",
    "react": "^19.2.7"
  }
}
