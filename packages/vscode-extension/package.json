{
  "name": "cangjie",
  "displayName": "Cangjie - 代码智能体",
  "description": "AI 原生代码智能平台 — VSCode 里的自主代码 Agent",
  "version": "0.1.0",
  "publisher": "cangjie",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": "https://github.com/wzhongyou/cangjie",
  "categories": ["Programming Languages", "Machine Learning", "Other"],
  "keywords": ["ai", "agent", "code", "claude", "cursor", "cangjie"],
  "engines": { "vscode": "^1.90.0" },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "cangjie.openChat", "title": "打开 Cangjie 对话" },
      { "command": "cangjie.inlineEdit", "title": "Cangjie: 行内编辑" },
      { "command": "cangjie.explainCode", "title": "Cangjie: 解释这段代码" }
    ],
    "keybindings": [
      { "command": "cangjie.inlineEdit", "key": "cmd+k", "when": "editorTextFocus" },
      { "command": "cangjie.openChat", "key": "cmd+shift+l", "when": "editorTextFocus" }
    ],
    "configuration": {
      "title": "Cangjie",
      "properties": {
        "cangjie.llm.provider": {
          "type": "string",
          "default": "anthropic",
          "enum": ["anthropic", "openai", "gemini", "local"],
          "description": "LLM 提供商"
        },
        "cangjie.llm.model": {
          "type": "string",
          "default": "claude-sonnet-4-6",
          "description": "模型名称"
        },
        "cangjie.llm.apiKey": {
          "type": "string",
          "default": "",
          "description": "API Key（建议用环境变量 ANTHROPIC_API_KEY）"
        },
        "cangjie.autoAllowReadOnly": {
          "type": "boolean",
          "default": true,
          "description": "自动放行只读工具（搜索、读文件等）"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc && npm run build:webview",
    "build:webview": "cd src/webview/chat && npx vite build",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "@cangjie/agent-runtime": "workspace:*",
    "@cangjie/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0"
  }
}
